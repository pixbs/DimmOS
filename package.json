{
  "name": "dimmos",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:ci",
    "test:ci": "bash tests/scripts/run-test-stack.sh all",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "bash tests/scripts/run-test-stack.sh integration",
    "test:e2e": "bash tests/scripts/run-test-stack.sh e2e",
    "test:e2e:all-browsers": "bash tests/scripts/run-test-stack.sh all-browsers",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:watch": "vitest --project unit --project component",
    "test:container": "bash tests/scripts/run-in-container.sh",
    "seed:cookies": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/seedCookieServices.ts",
    "seed:case-study": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/seed-case-study.ts",
    "seed:block-previews": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node src/scripts/seed-block-previews.ts",
    "test:e2e:run": "playwright test --config=playwright.config.ts",
    "test:integration:run": "vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-resend": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/plugin-form-builder": "3.84.1",
    "@payloadcms/plugin-sentry": "3.84.1",
    "@payloadcms/plugin-seo": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-vercel-blob": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@posthog/next": "^0.4.68",
    "@sentry/nextjs": "^10.55.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^12.40.0",
    "graphql": "^16.8.1",
    "next": "16.2.3",
    "payload": "3.84.1",
    "playwright-core": "1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remixicon": "^4.9.1",
    "sharp": "0.34.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/pg": "8.16.0",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/eslint-plugin": "1.6.24",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-playwright": "2.11.0",
    "msw": "2.15.0",
    "pg": "8.16.3",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "vitest-browser-react": "2.2.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
