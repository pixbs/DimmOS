DATABASE_URL=postgresql://localhost/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Resend email
RESEND_API_KEY=re_...

# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Canonical base URL — used for sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://dimm.co

# PostHog — https://app.posthog.com (create project → API key)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — https://sentry.io (create Next.js project → DSN)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=dimm-os
